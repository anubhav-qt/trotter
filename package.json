{
	"name": "trotter",
	"private": true,
	"description": "Personal algorithmic trading for NSE equities: the Trotter app, the Trotter agent and the trotter_trader engine",
	"type": "module",
	"workspaces": [
		"packages/*",
		"harness"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit && npm test",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"packages/*/test/**/*.test.ts\"",
		"cliproxy": "npm run cliproxy -w @trotter/harness --",
		"models": "npm run models -w @trotter/harness"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "24.19.2",
		"typescript": "7.0.2"
	}
}
