{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!archive", "!**/.cliproxy", "!**/package-lock.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNestedTernary": "error",
				"noNonNullAssertion": "error",
				"useBlockStatements": "error",
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/pi-ai/**", "packages/pi-agent/**"],
			"linter": {
				"rules": {
					"style": {
						"noNestedTernary": "off",
						"noNonNullAssertion": "off",
						"useBlockStatements": "off",
						"useNodejsImportProtocol": "off"
					},
					"suspicious": {
						"noExplicitAny": "off",
						"noControlCharactersInRegex": "off",
						"noEmptyInterface": "off"
					},
					"complexity": {
						"useOptionalChain": "off"
					}
				}
			}
		}
	]
}
