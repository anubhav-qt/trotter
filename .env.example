# Copy to .env.local and fill in your keys.

# Google AI (Gemini) — used for analyst commentary, target prices, and Deep Dive vision.
# Optional: without it, quantitative scores still work; AI commentary is skipped.
GOOGLE_API_KEY=

# Tavily Search — used to ground industry P/E in live web data.
# Optional: without it, the industry search step is skipped.
TAVILY_API_KEY=
