# Copy to .env.local and fill in what you need. Everything is optional:
# market data comes from free, account-less sources (NSE archives, Upstox
# public candles, Yahoo Finance fallback).

# Google AI (Gemini) — writes the plain-language reasoning and powers Deep Dive.
# Without it, scores, ranges and the track record still work.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Upstox access token — not required (historical candles are public), but
# raises rate limits if you have an Upstox account.
# UPSTOX_ACCESS_TOKEN=

# Where the SQLite database lives (default ./data/trotter.db).
# TROTTER_DB_PATH=./data/trotter.db

# History source priority and depth.
# TROTTER_HISTORY_SOURCES=upstox,yahoo
# TROTTER_HISTORY_YEARS=10

# Universe for the daily snapshot job: NIFTY 50 | NIFTY 100 | NIFTY 200 | NIFTY 500
# TROTTER_UNIVERSE=NIFTY 50
